---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import { playXExperiences } from '../../data/playx';
const experience = playXExperiences.find(({ slug }) => slug === 'ber-calculator')!;
---
<BaseLayout title="The Ber Calculator — playX" pageTitle="The Ber Calculator — playX | Field Notes" description={experience.description} image={experience.image} imageAlt={experience.imageAlt}>
  <header class="ber-hero">
    <div class="ber-hero-copy">
      <p class="kicker"><a href={withBase('playx/')}>playX</a></p>
      <p class="ber-label">September is here</p>
      <h1>The Ber<br />Calculator</h1>
      <p class="dek">If you start saving part of your salary this September, how much money could you have available by December 15?</p>
    </div>
    <figure>
      <img src={withBase(experience.image)} alt={experience.imageAlt} width="1600" height="2133" />
      <figcaption>Beer’s BER rule: feed the Christmas envelopes before December feeds on your wallet.</figcaption>
    </figure>
  </header>

  <div class="calculator" data-ber-calculator>
    <section class="controls" aria-labelledby="start-title">
      <div class="section-intro"><p class="step">01 · Start here</p><h2 id="start-title">Your salary, your rules</h2><p>Use your regular monthly basic salary. Everything updates in your browser as you go.</p></div>
      <div class="control-grid">
        <div class="salary-control"><label for="monthly-salary">Monthly basic salary</label><div class="money-input"><span>₱</span><input id="monthly-salary" data-salary type="number" inputmode="decimal" min="0" max="10000000" step="1000" value="50000" /></div></div>
        <fieldset><legend>Employment type</legend><div class="choice-row" data-employment><button type="button" class="choice active" data-value="sss" aria-pressed="true">Private · SSS</button><button type="button" class="choice" data-value="gsis" aria-pressed="false">Government · GSIS</button></div></fieldset>
        <div class="range-control"><label for="save-percent">Save from net salary each month</label><div class="range-row"><input id="save-percent" data-save-percent type="range" min="5" max="50" step="1" value="10" /><output data-save-output for="save-percent">10%</output></div></div>
        <div class="range-control"><label for="christmas-percent">Use for Christmas from the December pot</label><div class="range-row"><input id="christmas-percent" data-christmas-percent type="range" min="20" max="100" step="5" value="60" /><output data-christmas-output for="christmas-percent">60%</output></div></div>
        <div class="months-control"><label for="months-worked">Months worked this year</label><select id="months-worked" data-months>{Array.from({ length: 12 }, (_, index) => index + 1).map((month) => <option value={month} selected={month === 12}>{month} {month === 1 ? 'month' : 'months'}</option>)}</select></div>
        <button type="button" class="reset" data-reset>Reset calculator</button>
      </div>
    </section>

    <section class="payroll" aria-labelledby="payroll-title" aria-live="polite">
      <div class="section-intro"><p class="step">02 · Follow the money</p><h2 id="payroll-title">From gross pay to your pocket</h2><p>An estimated September payslip using the selected Philippine employee mode.</p></div>
      <div class="money-path">
        <div class="path-row gross"><span>Monthly basic salary</span><strong data-gross>₱0</strong></div>
        <div class="deduction-grid"><div><span data-social-label>SSS</span><strong data-social>₱0</strong></div><div><span>PhilHealth</span><strong data-philhealth>₱0</strong></div><div><span>Pag-IBIG</span><strong data-pagibig>₱0</strong></div><div><span>Estimated income tax</span><strong data-tax>₱0</strong></div></div>
        <div class="path-row deductions"><span>Total estimated deductions</span><strong data-total-deductions>₱0</strong></div>
        <div class="path-row net"><span>Estimated net salary <small>what reaches your pocket</small></span><strong data-net>₱0</strong></div>
      </div>
    </section>

    <section class="savings" aria-labelledby="savings-title">
      <div class="section-intro"><p class="step">03 · Pay yourself first</p><h2 id="savings-title">Your Ber-month habit</h2></div>
      <div class="save-pair"><div class="save-card primary"><span>Save every month</span><strong data-monthly-save>₱0</strong><small>from estimated net salary</small></div><div class="save-card"><span>Still spendable</span><strong data-spendable>₱0</strong><small>after monthly saving</small></div></div>
      <div class="timeline" data-timeline></div><p class="timeline-note">The December 15 stop includes a fourth monthly saving amount plus the estimated net 13th month.</p>
    </section>

    <section class="thirteenth-section" aria-labelledby="thirteenth-title">
      <div class="section-intro"><p class="step">04 · The extra month</p><h2 id="thirteenth-title">Your 13th-month estimate</h2><p>Monthly basic salary × months worked ÷ 12. Up to ₱90,000 of 13th-month pay and other qualifying benefits combined is generally tax-exempt.</p></div>
      <dl class="thirteenth-results"><div><dt>Gross estimate</dt><dd data-thirteenth-gross>₱0</dd></div><div><dt>Estimated extra tax</dt><dd data-thirteenth-tax>₱0</dd></div><div class="net-thirteenth"><dt>Estimated net 13th month</dt><dd data-thirteenth-net>₱0</dd></div></dl>
      <p class="tax-note" data-tax-note></p>
    </section>

    <section class="payoff" aria-labelledby="payoff-title">
      <p class="step">05 · December payoff</p><h2 id="payoff-title">By December 15, you could have</h2><strong class="pot" data-december-pot>₱0</strong><p class="pot-explainer">Four monthly savings deposits + estimated net 13th month</p>
      <div class="keep-enjoy"><div><span>Keep</span><strong data-keep>₱0</strong><small>stays saved</small></div><div><span>Enjoy</span><strong data-enjoy>₱0</strong><small>Christmas budget</small></div></div>
    </section>

    <section class="allocation" aria-labelledby="allocation-title">
      <div class="section-intro"><p class="step">06 · Give every peso a job</p><h2 id="allocation-title">Christmas spending allocation</h2><p>These suggestions apply only to the Enjoy amount. Adjust the Christmas percentage above whenever your priorities change.</p></div><div class="allocation-list" data-allocation></div>
    </section>

    <aside class="method-note"><h2>Planning estimate only</h2><p>Actual payroll deductions and withholding may vary depending on compensation structure, employer annualization, benefits and statutory contribution rules. The calculator assumes one Philippine employer, regular basic salary and no unpaid absences. It does not store or transmit your salary.</p><p class="source-links"><a href="https://bir-cdn.bir.gov.ph/BIR/pdf/RMC%20No.%2034-2025%20Annex%20A.pdf">BIR tax schedule</a><a href="https://www.sss.gov.ph/pay-contribution/">SSS contributions</a><a href="https://www.gsis.gov.ph/active-members/contributions/">GSIS contributions</a><a href="https://www.philhealth.gov.ph/advisories/2025/PA2025-0002.pdf">PhilHealth premium</a><a href="https://www.pagibigfund.gov.ph/document/pdf/payments/AcceptingPagIBIGPaymentsThroughOTC_24%20JAN%202025.pdf">Pag-IBIG membership savings</a></p></aside>
  </div>
  <footer class="provenance">Created for playX in 2026 from an original photograph supplied by the author.</footer>
  <script src="../../scripts/ber-calculator.ts"></script>
</BaseLayout>

<style>
  .ber-hero{padding:clamp(48px,7vw,94px) 0 68px;display:grid;grid-template-columns:.88fr 1.12fr;gap:clamp(34px,7vw,100px);align-items:end}.ber-hero-copy{padding-bottom:4vw}.ber-label{margin:48px 0 8px;color:var(--orange);font:600 11px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase}.ber-hero h1{margin:0 0 28px;font:400 clamp(58px,8vw,112px)/.83 var(--display);letter-spacing:-.045em}.ber-hero .dek{max-width:560px;color:var(--muted);font:400 clamp(18px,1.7vw,24px)/1.5 var(--serif)}.ber-hero figure{margin:0}.ber-hero img{width:100%;height:auto}.ber-hero figcaption{margin-top:10px;color:var(--muted);font:12px/1.5 var(--sans)}.calculator{margin-bottom:110px;border-top:1px solid var(--ink)}.calculator>section{padding:clamp(46px,6vw,82px) 0;border-bottom:1px solid var(--line)}.step{margin:0 0 18px;color:var(--orange);font:600 10px/1 var(--sans);letter-spacing:.15em;text-transform:uppercase}.section-intro{max-width:720px}.section-intro h2,.payoff h2{margin:0 0 18px;font:400 clamp(38px,5vw,64px)/1 var(--display)}.section-intro>p:last-child{color:var(--muted);font:17px/1.6 var(--serif)}.control-grid{margin-top:42px;display:grid;grid-template-columns:1.15fr .85fr;gap:28px clamp(34px,7vw,100px);align-items:end}.control-grid label,.control-grid legend{display:block;margin:0 0 10px;font:600 11px/1.3 var(--sans);letter-spacing:.08em;text-transform:uppercase}.control-grid fieldset{margin:0;padding:0;border:0}.money-input{display:flex;align-items:center;border-bottom:1px solid var(--ink)}.money-input span{font:400 36px/1 var(--display)}.money-input input{min-width:0;width:100%;padding:8px 12px 12px;border:0;background:transparent;color:var(--ink);font:400 clamp(34px,5vw,60px)/1 var(--display)}.choice-row{display:flex;gap:8px}.choice{min-height:46px;padding:0 17px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink);cursor:pointer;font:600 12px/1 var(--sans)}.choice.active{border-color:var(--blue);background:var(--blue);color:white}.range-row{display:flex;align-items:center;gap:20px}.range-row input{width:100%;accent-color:var(--orange)}.range-row output{min-width:58px;font:400 30px/1 var(--display)}.months-control select{width:100%;min-height:48px;padding:0 12px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:16px var(--sans)}.reset{justify-self:start;min-height:46px;padding:0 18px;border:1px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;font:600 11px/1 var(--sans);letter-spacing:.09em;text-transform:uppercase}.payroll{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(40px,8vw,120px)}.money-path{align-self:start}.path-row{display:flex;justify-content:space-between;gap:24px;align-items:baseline;padding:22px 0;border-bottom:1px solid var(--line)}.path-row strong{font:400 clamp(25px,3vw,38px)/1 var(--display)}.path-row.net{margin-top:16px;padding:24px;background:var(--blue);color:white;border:0}.path-row.net span{font-weight:600}.path-row.net small{display:block;margin-top:5px;opacity:.72;font-weight:400}.path-row.net strong{font-size:clamp(34px,4vw,54px)}.deduction-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);margin:18px 0}.deduction-grid>div{padding:20px;background:var(--surface)}.deduction-grid span{display:block;color:var(--muted);font:600 10px/1.3 var(--sans);letter-spacing:.08em;text-transform:uppercase}.deduction-grid strong{display:block;margin-top:10px;font:400 26px/1 var(--display)}.save-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:40px}.save-card{padding:28px;border:1px solid var(--line);background:var(--surface)}.save-card.primary{background:var(--blue);color:white;border-color:var(--blue)}.save-card span,.save-card small{display:block;font-size:12px}.save-card small{color:var(--muted)}.save-card.primary small{color:rgba(255,255,255,.72)}.save-card strong{display:block;margin:12px 0;font:400 clamp(38px,5vw,62px)/1 var(--display)}.timeline{display:grid;grid-template-columns:repeat(4,1fr);margin-top:38px}.timeline-item{position:relative;padding:28px 18px 18px;border-top:1px solid var(--ink);border-right:1px solid var(--line)}.timeline-item:last-child{border-right:0}.timeline-item:before{content:'';position:absolute;top:-6px;left:18px;width:11px;height:11px;border-radius:50%;background:var(--orange)}.timeline-item span{display:block;color:var(--orange);font:600 10px/1 var(--sans);letter-spacing:.1em;text-transform:uppercase}.timeline-item strong{display:block;margin:14px 0 6px;font:400 clamp(24px,2.7vw,36px)/1 var(--display)}.timeline-item small,.timeline-note{color:var(--muted)}.timeline-note{margin:18px 0 0;font:13px/1.5 var(--serif)}.thirteenth-section{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(38px,8vw,110px)}.thirteenth-results{margin:0}.thirteenth-results div{display:flex;justify-content:space-between;align-items:baseline;gap:22px;padding:20px 0;border-bottom:1px solid var(--line)}.thirteenth-results dt{color:var(--muted);font-size:13px}.thirteenth-results dd{margin:0;font:400 32px/1 var(--display)}.thirteenth-results .net-thirteenth{padding:24px;background:var(--surface);border-top:1px solid var(--ink)}.net-thirteenth dt{color:var(--ink);font-weight:600}.net-thirteenth dd{color:var(--blue);font-size:clamp(35px,4vw,50px)}.tax-note{grid-column:1/-1;margin:0;color:var(--muted);font:13px/1.6 var(--serif)}.payoff{text-align:center;padding:clamp(65px,9vw,118px) clamp(20px,5vw,70px)!important;background:var(--blue);color:white}.payoff .step{color:#efb08f}.payoff h2{max-width:850px;margin-inline:auto}.pot{display:block;margin:30px 0 12px;font:400 clamp(64px,10vw,138px)/.85 var(--display);letter-spacing:-.04em}.pot-explainer{color:rgba(255,255,255,.7);font:14px/1.5 var(--serif)}.keep-enjoy{max-width:760px;margin:52px auto 0;display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(255,255,255,.45)}.keep-enjoy>div{padding:28px;border-right:1px solid rgba(255,255,255,.28)}.keep-enjoy>div:last-child{border-right:0}.keep-enjoy span,.keep-enjoy small{display:block}.keep-enjoy span{font:600 11px/1 var(--sans);letter-spacing:.12em;text-transform:uppercase}.keep-enjoy strong{display:block;margin:12px 0;font:400 clamp(35px,5vw,58px)/1 var(--display)}.keep-enjoy small{opacity:.68}.allocation{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(38px,8vw,110px)}.allocation-list{display:grid;gap:12px}.allocation-item{display:grid;grid-template-columns:minmax(145px,.8fr) 1fr auto;gap:16px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line)}.allocation-item .label{font-size:13px}.allocation-item .bar{height:7px;background:var(--line)}.allocation-item .bar i{display:block;height:100%;background:var(--orange)}.allocation-item strong{font:400 26px/1 var(--display)}.allocation-item small{display:block;color:var(--muted)}.method-note{max-width:860px;margin:70px auto 0;color:var(--muted);font:15px/1.7 var(--serif)}.method-note h2{margin:0 0 16px;color:var(--ink);font:400 32px/1.1 var(--display)}.source-links{display:flex;flex-wrap:wrap;gap:8px 22px}.source-links a{text-decoration:underline;text-underline-offset:3px}.provenance{display:block;padding:26px 0 80px;border-top:1px solid var(--line);color:var(--muted);font:12px/1.5 var(--sans)}
  @media(max-width:800px){.ber-hero{grid-template-columns:1fr}.ber-hero-copy{order:2}.ber-hero figure{order:1}.ber-label{margin-top:30px}.payroll,.thirteenth-section,.allocation{grid-template-columns:1fr}.timeline{grid-template-columns:1fr 1fr}.timeline-item:nth-child(2){border-right:0}.timeline-item:nth-child(n+3){margin-top:20px}.tax-note{grid-column:1}}
  @media(max-width:620px){.control-grid,.save-pair{grid-template-columns:1fr}.choice-row{flex-wrap:wrap}.deduction-grid{grid-template-columns:1fr 1fr}.timeline{grid-template-columns:1fr}.timeline-item{border-right:0}.timeline-item:nth-child(n+2){margin-top:20px}.keep-enjoy{grid-template-columns:1fr}.keep-enjoy>div{border-right:0;border-bottom:1px solid rgba(255,255,255,.28)}.keep-enjoy>div:last-child{border-bottom:0}.allocation-item{grid-template-columns:1fr auto}.allocation-item .bar{grid-column:1/-1;grid-row:2}.pot{font-size:60px}.path-row.net{display:block}.path-row.net strong{display:block;margin-top:18px}.ber-hero h1{font-size:58px}}
  @media(max-width:420px){.deduction-grid{grid-template-columns:1fr}.allocation-item strong{font-size:23px}}
</style>
