---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import { playXExperiences } from '../../data/playx';
---
<BaseLayout title="playX" description="Playable experiments preserved as part of Field Notes." image="/images/playx/diwata-vs-kapre-preview.jpg" imageAlt="Pixel-art Diwata and Kapre facing each other in a forest">
  <header class="playx-header">
    <p class="kicker">Field Notes experiments</p>
    <h1>playX</h1>
    <p>Games, experiments and other things meant to be played with.</p>
  </header>
  <section class="playx-list" aria-labelledby="playx-games">
    <div class="section-heading"><h2 id="playx-games">Games</h2></div>
    <div class="playx-grid">
      {playXExperiences.map((experience) => <a class="playx-card" href={withBase(`playx/${experience.slug}/`)}>
        <img src={withBase(experience.image)} alt={experience.imageAlt} />
        <div>
          <p class="eyebrow">{experience.status} · {experience.year}</p>
          <h3>{experience.title}</h3>
          <p>{experience.description}</p>
          <span class="read-link">Play the experience <span aria-hidden="true">→</span></span>
        </div>
      </a>)}
    </div>
  </section>
</BaseLayout>

<style>
  .playx-header{padding:clamp(64px,9vw,120px) 0 56px;max-width:780px}.playx-header h1{font:400 clamp(66px,10vw,132px)/.9 var(--display);letter-spacing:-.04em;margin:24px 0}.playx-header>p:last-child{font:400 clamp(19px,2vw,26px)/1.5 var(--serif);color:var(--muted)}.playx-list{padding-bottom:120px}.playx-grid{display:grid;gap:72px}.playx-card{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:clamp(28px,6vw,80px);align-items:center}.playx-card img{width:100%;aspect-ratio:1200/630;object-fit:cover}.playx-card .eyebrow{display:block}.playx-card h3{font:400 clamp(36px,4.5vw,62px)/1 var(--display);margin:12px 0 18px}.playx-card p{color:var(--muted)}@media(max-width:720px){.playx-card{grid-template-columns:1fr}.playx-header{padding-top:55px}.playx-list{padding-bottom:80px}}
</style>
