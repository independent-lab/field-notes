---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import { playXExperiences } from '../../data/playx';
const experience = playXExperiences.find(({ slug }) => slug === 'diwata-vs-kapre')!;
const description = experience.description;
---
<BaseLayout title="Diwata vs. Kapre — playX" pageTitle="Diwata vs. Kapre — playX | Field Notes" description={description} image="/images/playx/diwata-vs-kapre-preview.jpg" imageAlt="Pixel-art Diwata and Kapre facing each other in a forest">
  <header class="game-page-header">
    <p class="kicker"><a href={withBase('playx/')}>playX</a></p>
    <h1>Diwata vs. Kapre</h1>
    <p>Originally created in 2023 · Preserved for playX in 2026</p>
  </header>

  <section class="game-stage" aria-label="Playable game" data-game-root data-hero-src={withBase('images/playx/diwata.png')} data-enemy-src={withBase('images/playx/kapre.png')} data-bullet-src={withBase('images/playx/feather.png')} data-background-src={withBase('images/playx/forest-background.webp')}>
    <div class="game-frame">
      <div class="game-hud" aria-label="Game status">
        <div class="health-wrap"><span>Health</span><div class="health-track"><div class="health-fill" data-health></div></div><strong data-health-text>10</strong></div>
        <strong class="score">Score <span data-score>0</span></strong>
        <button class="fullscreen-button" type="button" data-fullscreen aria-label="Enter fullscreen">Fullscreen</button>
      </div>
      <canvas data-canvas width="800" height="450" tabindex="0" aria-label="Diwata vs. Kapre game area">Your browser does not support the game canvas.</canvas>
      <section class="game-overlay" data-overlay aria-live="polite">
        <div>
          <p class="overlay-label">playX presents</p>
          <h2 data-overlay-title>Diwata vs. Kapre</h2>
          <p data-overlay-message>Defend the forest. Don’t let ten Kapres pass.</p>
          <p class="controls-copy"><span><kbd>↑</kbd> <kbd>↓</kbd> Move</span><span><kbd>Space</kbd> Fire</span></p>
          <button type="button" data-play disabled>Loading…</button>
        </div>
      </section>
    </div>
    <div class="touch-controls" aria-label="Touch game controls">
      <button type="button" data-move="up" aria-label="Move up">↑ <span>Up</span></button>
      <button type="button" data-move="down" aria-label="Move down">↓ <span>Down</span></button>
      <button type="button" data-fire aria-label="Fire">● <span>Fire</span></button>
    </div>
  </section>

  <footer class="game-notes">
    <p>Originally created for Siklab Serye, 2023 · Preserved in playX, 2026</p>
    <a class="read-link" href={withBase(`posts/${experience.relatedFieldNote}/`)}>Read the original Field Note <span aria-hidden="true">→</span></a>
  </footer>
  <script src="../../scripts/diwata-vs-kapre.ts"></script>
</BaseLayout>

<style>
  .game-page-header{padding:clamp(52px,7vw,90px) 0 38px;text-align:center}.game-page-header .kicker{justify-content:center}.game-page-header h1{font:400 clamp(48px,7vw,90px)/.95 var(--display);letter-spacing:-.03em;margin:20px 0 16px}.game-page-header>p:last-child{color:var(--muted);font:17px/1.5 var(--serif)}.game-stage{max-width:1080px;margin:0 auto}.game-frame{position:relative;overflow:hidden;background:#07120e;color:#fff;aspect-ratio:16/9}.game-frame canvas{display:block;width:100%;height:100%;touch-action:none}.game-hud{position:absolute;z-index:3;top:0;left:0;width:100%;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 16px;background:rgba(4,13,9,.78);font:600 12px/1 var(--sans);letter-spacing:.06em;text-transform:uppercase}.health-wrap{display:flex;align-items:center;gap:9px}.health-track{width:clamp(80px,16vw,170px);height:9px;background:rgba(255,255,255,.25)}.health-fill{height:100%;width:100%;background:#9bcf70}.score{margin-left:auto}.fullscreen-button{min-height:44px;padding:0 14px;border:1px solid rgba(255,255,255,.6);background:transparent;color:#fff;cursor:pointer;font:600 11px/1 var(--sans);letter-spacing:.06em;text-transform:uppercase}.fullscreen-button:focus-visible,.game-overlay button:focus-visible,.touch-controls button:focus-visible{outline:3px solid #f2b36f;outline-offset:3px}.game-overlay{position:absolute;z-index:2;inset:0;display:grid;place-items:center;padding:72px 24px 24px;text-align:center;background:rgba(3,11,8,.67)}.game-overlay[hidden]{display:none}.game-overlay>div{max-width:560px}.overlay-label{margin:0 0 10px;color:#c8dfad;font:600 11px/1.2 var(--sans);letter-spacing:.14em;text-transform:uppercase}.game-overlay h2{margin:0 0 14px;font:400 clamp(36px,6vw,68px)/1 var(--display)}.game-overlay p{font:18px/1.5 var(--serif)}.controls-copy{display:flex;justify-content:center;gap:24px;flex-wrap:wrap;margin:20px 0}.controls-copy span{white-space:nowrap}.controls-copy kbd{display:inline-grid;place-items:center;min-width:30px;min-height:28px;padding:2px 7px;border:1px solid rgba(255,255,255,.55);font:600 12px/1 var(--sans)}.game-overlay button{min-width:130px;min-height:48px;border:0;background:#f6f2e9;color:#17202b;cursor:pointer;font:600 12px/1 var(--sans);letter-spacing:.12em}.game-overlay button:disabled{cursor:wait;opacity:.65}.touch-controls{display:none;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.touch-controls button{min-height:56px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:600 20px/1 var(--sans);touch-action:none}.touch-controls span{display:block;margin-top:4px;font-size:10px;letter-spacing:.08em;text-transform:uppercase}.game-notes{max-width:1080px;margin:0 auto;padding:28px 0 110px;display:flex;justify-content:space-between;gap:24px;align-items:baseline;border-top:0}.game-notes p{color:var(--muted);font:14px/1.5 var(--serif)}@media(hover:none),(pointer:coarse),(max-width:700px){.touch-controls{display:grid}}@media(max-width:700px){.game-page-header h1{font-size:48px}.game-hud{padding:8px 9px;gap:9px}.game-hud>strong{font-size:10px}.fullscreen-button{padding:0 9px;font-size:9px}.game-overlay{padding:54px 8px 5px}.overlay-label{display:none}.game-overlay h2{margin-bottom:4px;font-size:28px}.game-overlay p{margin:4px 0 7px;font-size:12px;line-height:1.3}.game-overlay button{min-height:44px}.controls-copy{display:none}.game-notes{display:block;padding-bottom:75px}.health-wrap>span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}}
</style>
