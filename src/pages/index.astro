---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import { categories } from '../content.config';
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured.id).slice(0, 6);
---
<BaseLayout image={featured.data.heroImage}>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Featured essay</p>
      <h1><a href={`${base}posts/${featured.id}/`}>{featured.data.title}</a></h1>
      <p class="dek">{featured.data.subtitle}</p>
      <a class="read-link" href={`${base}posts/${featured.id}/`}>Read the essay <span aria-hidden="true">→</span></a>
    </div>
    <a class="hero-media" href={`${base}posts/${featured.id}/`}>
      <img src={`${base}${featured.data.heroImage.replace(/^\//, '')}`} alt={featured.data.heroAlt} />
      <span class="issue-note">Issue 01 · August 2026</span>
    </a>
  </section>
  <section>
    <div class="section-heading"><h2>Latest stories</h2><a href={`${base}archive/`}>View all →</a></div>
    <div class="stories-grid">{latest.map((post, index) => <StoryCard post={post} prominent={index < 3} />)}</div>
  </section>
  <nav class="category-strip" aria-label="Browse by section">
    {categories.map((category) => <a href={`${base}category/${category.toLowerCase()}/`}>{category}</a>)}
  </nav>
</BaseLayout>
