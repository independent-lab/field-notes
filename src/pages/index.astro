---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import { categories } from '../content.config';
import { withBase } from '../lib/paths';
import { isPublishedPost } from '../lib/posts';
import { playXExperiences } from '../data/playx';
const posts = (await getCollection('posts')).filter((post) => isPublishedPost(post)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured.id).slice(0, 6);
const featuredExperience = playXExperiences[0];
---
<BaseLayout image={featured.data.heroImage}>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Featured essay</p>
      <h1><a href={withBase(`posts/${featured.id}/`)}>{featured.data.title}</a></h1>
      <p class="dek">{featured.data.subtitle}</p>
      <a class="read-link" href={withBase(`posts/${featured.id}/`)}>Read the essay <span aria-hidden="true">→</span></a>
    </div>
    <a class="hero-media" href={withBase(`posts/${featured.id}/`)}>
      <img src={withBase(featured.data.heroImage)} alt={featured.data.heroAlt} />
      <span class="issue-note">Issue 01 · August 2026</span>
    </a>
  </section>
  <section>
    <div class="section-heading"><h2>Latest stories</h2><a href={withBase('archive/')}>View all →</a></div>
    <div class="stories-grid">{latest.map((post, index) => <StoryCard post={post} prominent={index < 3} />)}</div>
  </section>
  {featuredExperience && <section class="playx-discovery" aria-labelledby="from-playx">
    <div class="section-heading"><h2 id="from-playx">From playX</h2><a href={withBase('playx/')}>Explore playX →</a></div>
    <a class="playx-discovery-card" href={withBase(`playx/${featuredExperience.slug}/`)}>
      <img src={withBase(featuredExperience.image)} alt={featuredExperience.imageAlt} loading="lazy" />
      <div><p class="eyebrow">{featuredExperience.status} · {featuredExperience.year}</p><h3>{featuredExperience.title}</h3><p>{featuredExperience.description}</p><span class="read-link">Play <span aria-hidden="true">→</span></span></div>
    </a>
  </section>}
  <nav class="category-strip" aria-label="Browse by section">
    {categories.map((category) => <a href={withBase(`category/${category.toLowerCase()}/`)}>{category}</a>)}
  </nav>
</BaseLayout>

<style>
  .playx-discovery{padding-bottom:100px}.playx-discovery-card{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(260px,.85fr);gap:clamp(30px,6vw,80px);align-items:center}.playx-discovery-card img{width:100%;aspect-ratio:1200/630;object-fit:cover}.playx-discovery-card .eyebrow{display:block}.playx-discovery-card h3{font:400 clamp(34px,4vw,56px)/1 var(--display);margin:12px 0 18px}.playx-discovery-card p{color:var(--muted)}@media(max-width:720px){.playx-discovery{padding-bottom:76px}.playx-discovery-card{grid-template-columns:1fr}}
</style>
