---
import { getCollection } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Archive" description="Every story published in Field Notes.">
  <header class="page-header"><p class="kicker">The complete index</p><h1>Archive</h1><p>Essays, field notes, and observations—ordered from newest to oldest.</p></header>
  <section style="padding:35px 0 110px">{posts.map((post) => <article class="archive-row"><time>{post.data.pubDate.toLocaleDateString('en',{month:'short',year:'numeric'})}</time><h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2><a class="archive-category" href={`${base}category/${post.data.category.toLowerCase()}/`}>{post.data.category}</a></article>)}</section>
</BaseLayout>
